<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>URL Shortener (${environment})</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 560px; margin: 4rem auto; padding: 0 1rem; }
    input { width: 100%; padding: .6rem; font-size: 1rem; box-sizing: border-box; }
    button { margin-top: .75rem; padding: .6rem 1.2rem; font-size: 1rem; cursor: pointer; }
    #result { margin-top: 1.5rem; word-break: break-all; }
    .env { font-size: .8rem; color: #666; }
  </style>
</head>
<body>
  <h1>URL Shortener</h1>
  <p class="env">Environment: ${environment} · deployed by Terraform + GitHub Actions</p>
  <form id="f">
    <input id="url" type="url" placeholder="https://example.com/a/very/long/link" required>
    <button type="submit">Shorten</button>
  </form>
  <div id="result"></div>
  <script>
    var API = "${api_url}".replace(/\/$/, "");
    document.getElementById("f").addEventListener("submit", function (e) {
      e.preventDefault();
      var out = document.getElementById("result");
      out.textContent = "Working...";
      fetch(API + "/links", {
        method: "POST",
        headers: { "content-type": "application/json" },
        body: JSON.stringify({ url: document.getElementById("url").value })
      })
        .then(function (r) { return r.json(); })
        .then(function (data) {
          if (data.short_url) {
            out.innerHTML = "";
            var a = document.createElement("a");
            a.href = data.short_url; a.textContent = data.short_url;
            out.appendChild(a);
          } else {
            out.textContent = data.error || "Something went wrong";
          }
        })
        .catch(function () { out.textContent = "Request failed"; });
    });
  </script>
</body>
</html>
